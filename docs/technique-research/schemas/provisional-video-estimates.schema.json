{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provisional manual image-angle proxies",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "dataset_kind", "annotations_document", "source_registry", "anatomical_joint_angles_measured", "true_edge_angles_measured", "physical_turn_durations_measured", "estimates"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "dataset_kind": {"const": "provisional_manual_image_estimates_not_technique_norms"},
    "annotations_document": {"type": "string"}, "source_registry": {"type": "string"},
    "anatomical_joint_angles_measured": {"const": false}, "true_edge_angles_measured": {"const": false}, "physical_turn_durations_measured": {"const": false},
    "estimates": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["estimate_id", "sample_id", "source_id", "source_url", "player_locator_s", "metric_id", "unit", "estimate_rounded_5_deg", "marker_sensitivity_grid_rounded_outward_5_deg", "sensitivity_is_total_error_bound", "confidence_probability", "evidence_basis", "angle_reference", "context", "limitations", "permitted_use", "validated_for_openski", "coaching_threshold", "boot_imu_transfer"],
        "properties": {
          "estimate_id": {"type": "string"}, "sample_id": {"type": "string"}, "source_id": {"type": "string"}, "source_url": {"type": "string", "format": "uri"},
          "player_locator_s": {"type": "number", "minimum": 0}, "metric_id": {"type": "string"}, "unit": {"const": "deg"},
          "estimate_rounded_5_deg": {"type": "number", "minimum": -180, "maximum": 180, "multipleOf": 5},
          "marker_sensitivity_grid_rounded_outward_5_deg": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": -180, "maximum": 180, "multipleOf": 5}},
          "sensitivity_is_total_error_bound": {"const": false}, "confidence_probability": {"type": "null"},
          "evidence_basis": {"const": "manual_2d_marker_estimate"},
          "angle_reference": {"enum": ["image_vertical", "180_minus_proxy_included_angle"]},
          "context": {"type": "string"}, "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "permitted_use": {"const": "research_visual_proxy_only"}, "validated_for_openski": {"const": false}, "coaching_threshold": {"const": false}, "boot_imu_transfer": {"const": "not_directly_measurable"}
        }
      }
    }
  }
}
