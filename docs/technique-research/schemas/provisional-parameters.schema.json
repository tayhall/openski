{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenSki provisional experimental parameters",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "created_at", "status", "production_coaching_enabled", "automatic_firmware_application_allowed", "video_estimates_document", "references", "parameters", "literature_timing_examples", "unknowns", "manufacturer_document_check"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "profile_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date"},
    "status": {"const": "provisional_not_field_validated"},
    "production_coaching_enabled": {"const": false},
    "automatic_firmware_application_allowed": {"const": false},
    "video_estimates_document": {"type": "string"},
    "references": {"type": "object", "additionalProperties": {"type": "object", "required": ["scope"], "properties": {"scope": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "document": {"type": "string"}, "source_id": {"type": "string"}, "accessed_at": {"type": "string", "format": "date"}}}},
    "parameters": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["parameter_id", "category", "value", "unit", "selected_for_experiment", "production_coaching_allowed", "applicable_to", "rationale", "evidence_refs", "validation", "limitations"],
        "properties": {
          "parameter_id": {"type": "string", "minLength": 1},
          "category": {"enum": ["engineering_start", "published_replication", "unresolved"]},
          "value": {"type": ["number", "array", "null"], "items": {"type": "number"}},
          "unit": {"type": "string"},
          "selected_for_experiment": {"type": "boolean"},
          "production_coaching_allowed": {"const": false},
          "applicable_to": {"type": "string"},
          "rationale": {"type": "string"},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "validation": {"type": "string"},
          "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "allOf": [{"if": {"properties": {"category": {"const": "unresolved"}}}, "then": {"properties": {"value": {"type": "null"}, "selected_for_experiment": {"const": false}}}, "else": {"properties": {"value": {"type": ["number", "array"]}}}}]
      }
    },
    "literature_timing_examples": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["example_id", "source_ref", "locator", "technique", "turn_count", "mean_turn_duration_s", "reported_sd_s", "status", "openski_validated"],
        "properties": {
          "example_id": {"type": "string"}, "source_ref": {"type": "string"}, "locator": {"type": "string"}, "technique": {"type": "string"},
          "turn_count": {"type": "integer", "minimum": 1}, "mean_turn_duration_s": {"type": "number", "exclusiveMinimum": 0}, "reported_sd_s": {"type": "number", "minimum": 0},
          "status": {"const": "source_example_not_population_reference_or_ideal"}, "openski_validated": {"const": false}
        }
      }
    },
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "manufacturer_document_check": {"type": "string"}
  }
}
